# Setlist.fm — free key: setlist.fm -> log in -> https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# Spotify — developer.spotify.com/dashboard -> Create app -> copy both values
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 — free key: console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Genius (optional, free) — genius.com/api-clients -> New API Client -> "Generate Access Token"
# Improves detection of SoundCloud-only releases so they aren't marked unreleased
GENIUS_ACCESS_TOKEN=

# Supabase (not needed yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude (optional) — console.anthropic.com -> API keys. Powers the written
# Wrapped recap and artist suggestions. Everything else works without it.
ANTHROPIC_API_KEY=

# Web Push (anniversary notifications). Generate a keypair once with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Service role key (Supabase -> Settings -> API). SERVER ONLY — never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Random string; Vercel sends it as a Bearer token to the cron route.
CRON_SECRET=

# Ticketmaster Discovery (free, 5000 calls/day) — developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Last.fm (free) — www.last.fm/api/account/create. ListenBrainz needs no key.
LASTFM_API_KEY=

# Apple MusicKit (optional; requires Apple Developer Program).
# Full-song playback stays hidden until this is set.
NEXT_PUBLIC_MUSICKIT_DEVELOPER_TOKEN=
